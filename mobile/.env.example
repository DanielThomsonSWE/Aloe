# Demo works without a backend. Supabase mode also uses the Python API.
EXPO_PUBLIC_DATA_MODE=demo
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Existing deployments may keep using this public-key alias.
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
